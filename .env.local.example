# Copy to .env.local and fill in. NEVER commit .env.local.
#
# These keys are used ONLY by the eval harness (`npm run eval`), which runs in
# Node on a dev machine. The deployed app never reads env vars — HJ's keys are
# entered in the Einstellungen screen and stored in IndexedDB on his machine.

# --- ASR candidates ---
# AssemblyAI, EU region (https://api.eu.assemblyai.com)
ASSEMBLYAI_API_KEY=

# ElevenLabs Scribe
ELEVENLABS_API_KEY=

# Mistral (Voxtral)
MISTRAL_API_KEY=

# OpenAI (baseline comparison only — US endpoint)
OPENAI_API_KEY=

# --- Drafting / verification (used from P4 onward) ---
ANTHROPIC_API_KEY=
